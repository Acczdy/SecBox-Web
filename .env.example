# SecBox-Web 环境配置示例
# OOB 端口仅允许 1024-65535；三个端口不能重复，也不能与 Web 端口 5001 重复。
# 部署前还需在服务器安全组/防火墙中放行所选 TCP 端口。
OOB_RMI_PORT=
OOB_LDAP_PORT=
OOB_HTTP_CALLBACK_PORT=

# 可选 AI 分析
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1600
AI_TRUST_ENV_PROXY=0
AI_DATA_RETENTION_HOURS=24
