# 复制为项目根目录的 .env，再把下面三个值改成你自己的高位端口。
# 仅允许 1024-65535；三个端口不能重复，也不能与 Web 端口 5001 重复。
# 部署前还需在服务器安全组/防火墙中放行所选 TCP 端口。
OOB_RMI_PORT=
OOB_LDAP_PORT=
OOB_HTTP_CALLBACK_PORT=

# 可选：启用邮件与扫描报告 AI 深度分析。
# AI_API_KEY 留空时，基础解析和导出正常可用，AI 按钮显示未配置。
AI_API_URL=https://api.stepfun.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=step-router-v1
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1600
AI_TRUST_ENV_PROXY=0
AI_DATA_RETENTION_HOURS=24
